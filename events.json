{
  "schema": 3,
  "sidecar": "files",
  "layers": [
    "sidecar"
  ],
  "events": {
    "log.open": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema": {
            "type": "number"
          },
          "pid": {
            "type": "number"
          },
          "role": {
            "type": "string"
          },
          "boot": {
            "type": "string"
          }
        },
        "required": [
          "schema",
          "pid",
          "role",
          "boot"
        ]
      },
      "description": "The first line of every event file."
    },
    "log.dropped": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "from_seq": {
            "type": "number"
          },
          "to_seq": {
            "type": "number"
          },
          "count": {
            "type": "number"
          },
          "bytes": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "queued": {
            "type": "number"
          }
        },
        "required": [
          "from_seq",
          "to_seq",
          "count",
          "bytes",
          "reason",
          "channel"
        ]
      },
      "description": "A range of seq that the writer refused; it explains the gap. channel is other for the events of the levels error, warn and info and debug for the events of the levels debug and trace; it is stored in the main file. queued is the largest number of events that waited in the writer queue at a refusal that the record counts; it is absent for a loss that a source reports through the pull."
    },
    "log.rotated": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bytes": {
            "type": "number"
          },
          "generation": {
            "type": "number"
          }
        },
        "required": [
          "bytes",
          "generation"
        ]
      },
      "description": "A file was closed as the generation with this number and a new file started; no generation is removed."
    },
    "log.policy": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "classes": {
            "type": "object"
          }
        },
        "required": [
          "source",
          "classes"
        ]
      },
      "description": "The policy of the event log that is now in force: source is default when no policy file exists and file when the policy file holds it; classes holds the least severe level that is stored for each class. The first policy of a writer and every change of it are stored; the same policy again is not."
    },
    "log.gated": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "class": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "class",
          "level",
          "count"
        ]
      },
      "description": "The number of events of the class and the level that the gate of the host refused since the earlier report, so no event is lost without a count."
    },
    "sidecar.files.start": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pid": {
            "type": "number"
          },
          "goos": {
            "type": "string"
          },
          "goarch": {
            "type": "string"
          }
        },
        "required": [
          "pid",
          "goos",
          "goarch"
        ]
      },
      "description": "The sidecar started and reads requests."
    },
    "sidecar.files.exit": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "number"
          }
        },
        "required": [
          "status"
        ]
      },
      "description": "The sidecar ends with this exit status: 0 when its input closed, 1 for a failure."
    },
    "sidecar.files.failure": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "description": "A failure ended the sidecar: a reply that cannot be written, or a read error."
    },
    "sidecar.files.request_refused": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "description": "A request line was refused: it does not parse or names no surface. The sidecar answers a line that names its surface with the error, and keeps running."
    },
    "sidecar.files.panic": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "routine": {
            "type": "string"
          },
          "panic": {
            "type": "string"
          },
          "stack": {
            "type": "string"
          }
        },
        "required": [
          "routine",
          "panic",
          "stack"
        ]
      },
      "description": "A goroutine panicked; the process ends with status 2."
    },
    "sidecar.files.request": {
      "layer": "sidecar",
      "class": "call",
      "level": [
        "info",
        "warn"
      ],
      "result": true,
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "surface": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "paths": {
            "type": "array"
          },
          "generation": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          },
          "micros": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "surface",
          "operation",
          "ok",
          "micros"
        ]
      },
      "description": "A request was answered; the cids are those of the request line, and error names a failed request as <code>: <text>. The text of a write is not stored."
    },
    "sidecar.files.watch_start": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "surface": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "surface",
          "path"
        ]
      },
      "description": "A watch of a directory or a file started; path is relative to the project folder."
    },
    "sidecar.files.watch_change": {
      "layer": "sidecar",
      "class": "io",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "surface": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "surface",
          "path"
        ]
      },
      "description": "A watched directory or file changed and the sidecar reported it."
    },
    "sidecar.files.watch_end": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "surface": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "surface",
          "path",
          "reason"
        ]
      },
      "description": "A watch ended; reason is replaced, closed, input closed or start failed."
    },
    "sidecar.files.watch_failed": {
      "layer": "sidecar",
      "class": "lifecycle",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "surface": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "surface",
          "path",
          "error"
        ]
      },
      "description": "A watch failed on its own or did not stop; the sidecar reported the error to the surface."
    },
    "sidecar.files.git": {
      "layer": "sidecar",
      "class": "call",
      "level": [
        "info",
        "warn"
      ],
      "result": true,
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "surface": {
            "type": "string"
          },
          "args": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "micros": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "surface",
          "args",
          "ok",
          "micros"
        ]
      },
      "description": "One call of git; error is the exit status of git as the code. A folder outside a repository answers 128, which the request reports as an empty status."
    }
  }
}
